{
  "name": "onboarding-buddy",
  "private": true,
  "version": "0.1.0",
  "description": "Onboarding Buddy \u2014 A-to-Z onboarding: HR meets job training.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node server/index.mjs",
    "seed": "node server/seed.mjs",
    "test": "node --test 'test/*.test.mjs'",
    "build": "tsc -b && vite build",
    "start": "node server/seed.mjs --if-empty && NODE_ENV=production node server/index.mjs",
    "build:demo": "tsc -b && vite build --config vite.demo.config.ts && cp dist-demo/index.html dist-demo/404.html"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@noble/hashes": "^2.4.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "buffer": "^6.0.3",
    "sql.js": "^1.15.1",
    "typescript": "~6.0",
    "vite": "^8.3.4"
  }
}
